# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.keystore
*.jks
keystore.properties
google-services.json
android/app/google-services.json
*.p8
*.p12
*.mobileprovision
service-account*.json
play-service-account*.json

# ---- Node ----
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# ---- Expo ----
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ---- Metro / RN ----
.metro-health-check*
*.jsbundle
.haste_map.json

# ---- Android ----
android/.gradle/
android/build/
android/app/build/
android/.cxx/
android/local.properties
android/captures/
android/app/release/
android/app/debug/
*.apk
*.aab
*.ap_
*.dex
*.hprof

# ---- Rust ----
target/
**/target/
Cargo.lock
*.pdb

# ---- Rust native output copied into the app ----
android/app/src/main/jniLibs/

# ---- Editors / OS ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
.DS_Store
Thumbs.db
*.swp

# ---- Claude Code ----
.claude/settings.local.json

# ---- Misc ----
coverage/
*.log
.tmp/

# ---- Added from the Expo template ----
.kotlin/
*.orig.*
*.key
*.pem
yarn-debug.*
*.tsbuildinfo

# The Expo template also ignores the generated native folders outright.
# Your rules above assume android/ IS committed (see the jniLibs entry),
# which is the usual choice when you are writing your own native code.
# Uncomment these only if you switch to a prebuild-regenerates-everything
# workflow - they are mutually exclusive with the android/ rules above.
#/android
#/ios
